{
  "info": {
    "name": "TaskFlow API — UC14",
    "description": "Dias 1 e 2: erros padronizados, validação e CRUD. Execute a coleção completa após preencher email e senha no ambiente. Cria e exclui apenas os registros temporários da execução. Mantém PUT parcial compatível com o Kanban.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "idInexistente",
      "value": "2147483647",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName.startsWith('Login →')) { pm.collectionVariables.set('execucao', Date.now() + '-' + Math.random().toString(36).slice(2, 8)); ['token', 'tarefaId', 'usuarioTesteId', 'tokenUsuarioTeste', 'projetoTesteId'].forEach(k => pm.collectionVariables.unset(k)); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login → 200 (salva token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status esperado: 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); pm.collectionVariables.set('usuarioLogadoId', pm.response.json().usuario.id); } else { pm.collectionVariables.unset('token'); pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ]
        }
      ]
    },
