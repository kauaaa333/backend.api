generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auditoria_tarefas {
  id             Int      @id @default(autoincrement())
  tarefa_id      Int
  coluna_antes   String?  @db.VarChar(10)
  coluna_depois  String?  @db.VarChar(10)
  alterado_em    DateTime @default(now()) @db.Timestamptz(6)
  operacao       String   @db.VarChar(10)
  alterado_por   Int?
  responsavel_id Int?
  origem         String   @default("legado") @db.VarChar(10)

  @@index([tarefa_id, alterado_em], map: "auditoria_tarefas_tarefa_idx")
}

model comentarios {
  id            Int      @id @default(autoincrement())
  texto         String
  tarefa_id     Int
  usuario_id    Int
  criado_em     DateTime @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime @default(now()) @db.Timestamptz(6)
  tarefas       tarefas  @relation(fields: [tarefa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios      usuarios @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)

  @@index([tarefa_id])
  @@index([usuario_id])
}

model prioridades {
  id        Int       @id @default(autoincrement())
  descricao String    @unique @db.VarChar(20)
  criado_em DateTime  @default(now()) @db.Timestamptz(6)
  ativo     Boolean   @default(true)
  tarefas   tarefas[]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model projetos {
  id            Int       @id @default(autoincrement())
  nome          String    @db.VarChar(100)
  descricao     String?   @db.VarChar(200)
  criado_em     DateTime  @default(now()) @db.Timestamptz(6)
  usuario_id    Int
  atualizado_em DateTime  @default(now()) @db.Timestamptz(6)
  usuarios      usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tarefas       tarefas[]

  @@index([usuario_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tarefas {
  id            Int           @id @default(autoincrement())
  texto         String
  coluna        String        @default("afazer") @db.VarChar(10)
  usuario_id    Int?
  projeto_id    Int?
  concluida_em  DateTime?     @db.Timestamptz(6)
  criado_em     DateTime      @default(now()) @db.Timestamptz(6)
  iniciada_em   DateTime?     @db.Timestamptz(6)
  atualizado_em DateTime      @default(now()) @db.Timestamptz(6)
  ordem         Int           @default(0)
  idprioridade  Int           @default(3)
  comentarios   comentarios[]
  prioridades   prioridades   @relation(fields: [idprioridade], references: [id], onUpdate: NoAction)
  projetos      projetos?     @relation(fields: [projeto_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  usuarios      usuarios?     @relation(fields: [usuario_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([idprioridade])
  @@index([projeto_id])
  @@index([usuario_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios {
  id            Int           @id @default(autoincrement())
  nome          String        @db.VarChar(100)
  email         String        @unique @db.VarChar(150)
  senha_hash    String        @db.VarChar(255)
  criado_em     DateTime      @default(now()) @db.Timestamptz(6)
  atualizado_em DateTime      @default(now()) @db.Timestamptz(6)
  administrador Boolean       @default(false)
  comentarios   comentarios[]
  projetos      projetos[]
  tarefas       tarefas[]
}
